# URL do seu projeto Supabase (Configuracoes > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anonima publica (Configuracoes > API > Project API Keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Chave de servico secreta (Configuracoes > API > Project API Keys > service_role secret)
# AVISO: Nunca exponha esta chave no client-side. Use apenas no servidor (API routes).
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Local: URL do mesmo projeto Supabase (dispensa variável pública no formulário).
SUPABASE_URL=https://seu-projeto.supabase.co

# Amplify: configure somente estas referências nas variáveis de build.
# Guarde SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY no JSON do Secrets Manager.
# LEADS_SECRET_ARN=arn:aws:secretsmanager:sa-east-1:123456789012:secret:smartboi/leads-XXXXXX
# LEADS_AWS_REGION=sa-east-1
